#!/usr/bin/perl

use strict;
use warnings;
use feature 'signatures';
use FindBin qw($Bin);
use lib $Bin;
use Cwd qw(abs_path);
use File::Find ();
use File::Glob qw(bsd_glob);
use File::Slurp qw(read_file append_file);

my $root           = abs_path("$Bin/..");
my $inventory_file = "$Bin/inventory.list";
my $sprite_width   = 32;

# usage: give-item NAME
#        give-item NAME#{DATA}
#
# NAME is [-A-Za-z0-9]+, see the inventory section of the developer docs.
# The syntax inside the braces is the owner module's business and is not checked.
@ARGV == 1 or do { print STDERR "usage: give-item NAME[#{DATA}]\n"; exit 64 };
my $arg = $ARGV[0];

my ($item) = $arg =~ /\A([-A-Za-z0-9]+)(?:#\{.*\})?\z/
    or do {
        print STDERR "give-item: invalid item '$arg', expected NAME or NAME#{...}\n";
        exit 1;
    };

# Cure item/ and ALL module item/, recursively.
# Disabling a module does not revoke its items.
sub item_dirs() {
    return grep { -d } (
        "$root/item",
        sort(bsd_glob("$root/module/*/item")),
    );
}

sub find_sprite($name) {
    my $found;
    for my $dir (item_dirs()) {
        File::Find::find({
            no_chdir => 1,
            wanted   => sub {
                return if defined $found;
                $found = $_ if -f $_ && m{/\Q$name\E\.ascii\z};
            },
        }, $dir);
        last if defined $found;
    }
    return $found;
}

append_file($inventory_file, "$arg\n")
    or die "Append operation failed for '$inventory_file': $!";

my $sprite_path = find_sprite($item) // find_sprite('undefined');
my $sprite      = defined $sprite_path ? read_file($sprite_path) : '';

# center sprite to message
my $message = "A '$item' has been added to your inventory!";
my $message_length = length($message);
my $pad_amount = int(($message_length - $sprite_width) / 2);
$pad_amount = 0 if $pad_amount < 0;
my $padding = ' ' x $pad_amount;

if (length $sprite) {
    chomp $sprite;
    $sprite = join("\n", map { "$padding$_" } split(/\n/, $sprite, -1));
    $sprite .= "\n";
}

print $sprite;
print "\e[1;32m$message\e[0m\n";
