#!/usr/bin/perl

# A piece of paper with a code drifts by.
# The code is already valid, but it is only known to the player once the paper is read.
use strict;
use warnings;
use FindBin qw($RealBin);
use lib $RealBin;
use Bunker qw(codes_load codes_save paper_save max_concurrent random_code);

my $codes = codes_load();

# Make room: keep at most (max-concurrent - 1) existing codes,
# dropping the oldest ones until there is space for the new one.
my $keep = max_concurrent() - 1;
$keep = 0 if $keep < 0;
shift @$codes while @$codes > $keep;

# New id = smallest positive integer not currently in use.
my %used = map { $_->[0] => 1 } @$codes;
my $id = 1;
$id++ while $used{$id};

my $code = random_code();
push @$codes, [ $id, $code ];
codes_save($codes);
paper_save([ $id, $code ]);

print "\e[1;33m[A piece of paper drifts by you in the wind]\e[0m\n";
