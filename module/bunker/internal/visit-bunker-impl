#!/usr/bin/perl

use strict;
use warnings;
use feature 'signatures';
use FindBin qw($Bin);
use lib $Bin;
use File::Slurp qw(read_file);
use Term::ReadLine;
use Bunker qw(load_codes save_codes);

if (($ENV{BUNKER_ENCOUNTER} // '') ne 'true') {
    exit 1;
}

my $codes = load_codes();

if (!@$codes) {
    print "\e[33mThe door has no keyhole you recognize. You'll need a code first.\e[0m\n";
    exit 0;
}

# Pick one of the codes you're known to be carrying, and burn it
# immediately -- win or lose, a bunker only gets tried once.
my $idx = int(rand(scalar @$codes));
my ($entry) = splice(@$codes, $idx, 1);
save_codes($codes);

my ($id, $code) = ($entry->{id}, $entry->{code});

sub load_sprite($name) {
    my $sprite = read_file("$Bin/$name");
    $sprite =~ s/%/$id/g;
    return $sprite;
}

my $closed_sprite = load_sprite('bunker-door-closed.ascii');
my $locked_sprite = load_sprite('bunker-door-locked.ascii');
my $open_sprite   = load_sprite('bunker-door-open.ascii');

print $closed_sprite;

my $term = Term::ReadLine->new('');
my $guess = $term->readline('The bunker door asks for a code: ');
$guess = '' unless defined $guess;

chomp $guess;
$guess =~ s/-//g;
$guess = uc $guess;

if ($guess eq $code) {
    print $open_sprite;

    if (my $callback = $ENV{BUNKER_SUCCESS_CALLBACK}) {
        exec($callback) or die "Couldn't exec BUNKER_SUCCESS_CALLBACK: $!";
    } else {
        print "\e[32mYou managed to open the bunker! :)\e[0m\n";
    }
} else {
    print $locked_sprite;
    print "\e[31mThe bunker has shut itself forever.\e[0m\n";
    exit 1;
}
